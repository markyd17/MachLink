# Personal config - config.example.yaml is the tracked template.
# Copy it to config.yaml locally; that copy has your real SimBrief
# username/paths and should never be committed.
config.yaml

# Runtime output - regenerated by the app, not source.
machlink.log
data/flight_log.json
data/flight_debug.log
__pycache__/
*.pyc

# Personal/hardware-specific exports - tied to this machine's physical
# HOTAS devices or local export tool, not portable settings.
data/bindings_live/
Joystic Diagrams/

# Third-party reference PDFs - not app source, too large for GitHub
# (100MB+ each), and not ours to redistribute.
*.pdf

# One-off working backup made during an earlier redesign - not part of
# the project history worth keeping.
_pre_mfd_redesign_backup/

# Editor/OS cruft
.vscode/
.idea/
Thumbs.db
.DS_Store

# Claude Code local dev-server config for the browser preview tool -
# machine-specific launch command, not app source.
.claude/
